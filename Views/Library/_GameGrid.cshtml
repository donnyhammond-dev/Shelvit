@using BackLog.ViewModels.GameViewModels
@using BackLog.Helpers

@model LibraryViewModel

<div class="container py-3">
	<div class="row g-3">

		@foreach (var game in Model.Games.Items)
		{
			<div class="col-4 col-sm-3 col-md-2">
				<div class="portrait-grid-image"
					 title="@game.Title&#10;@game.Year&#10;@game.Platform.GetDisplayName()&#10;@game.Status.GetDisplayName()&#10;@(game.Rating.HasValue ? $"{game.Rating}/5" : "")">

					<img src="@(game.CustomImageUrl ?? game.ImageUrl ?? "/images/placeholder.png")"
						 alt="@game.Title" />

				</div>
			</div>
		}

	</div>
</div>