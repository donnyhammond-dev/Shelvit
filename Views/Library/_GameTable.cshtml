@using BackLog.ViewModels.PartialViewModels
@using BackLog.ViewModels.GameViewModels
@using BackLog.Helpers

@model LibraryViewModel

	<div class="table-responsive">
		<table class="table table-striped table-hover">

			<!--Table Header-->
			<thead class="table-header">
				<tr>
					<th class="game-image-col"><!--Game Images Column--></th>
				<th class="game-title-col">
						<a asp-action="Index"
						   class="sort-link"
						   title="Sort By Title"
						   asp-route-SortBy="Title"
						   asp-route-IsDesc="@(Model.SortBy == "Title"  || Model.SortBy == null? !Model.IsDesc : false)"
						   asp-route-Search="@Model.Search"
						   asp-route-Platform="@Model.Platform"
						   asp-route-Genre="@Model.Genre"
						   asp-route-Status="@Model.Status"
						   asp-route-StatusGroup="@Model.StatusGroup"
				  	       asp-route-isViewAllMode="@Model.IsViewAllMode">
							Title
							@if (Model.SortBy == "Title" || Model.SortBy == null)
							{
								<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
							}
						</a>
					</th>
				<th class="d-none d-lg-table-cell">
						<a asp-action="Index"
						   class="sort-link"
						   title="Sort By Year"
						   asp-route-SortBy="Year"
						   asp-route-IsDesc="@(Model.SortBy == "Year" ? !Model.IsDesc : false)"
						   asp-route-Search="@Model.Search"
						   asp-route-Platform="@Model.Platform"
						   asp-route-Genre="@Model.Genre"
						   asp-route-Status="@Model.Status"
						   asp-route-StatusGroup="@Model.StatusGroup"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
							Year
							@if (Model.SortBy == "Year")
							{
								<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
							}
						</a>
					</th>
					<th>
						<a asp-action="Index"
						   class="sort-link"
						   title="Sort By Platform"
						   asp-route-SortBy="Platform"
						   asp-route-IsDesc="@(Model.SortBy == "Platform" ? !Model.IsDesc : false)"
						   asp-route-Search="@Model.Search"
						   asp-route-Platform="@Model.Platform"
						   asp-route-Genre="@Model.Genre"
						   asp-route-Status="@Model.Status"
						   asp-route-StatusGroup="@Model.StatusGroup"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
							Platform
							@if (Model.SortBy == "Platform")
							{
								<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
							}
						</a>
					</th>
				<th class="d-none d-lg-table-cell">
						<a asp-action="Index"
					       class="sort-link"
						   title="Sort By Genre"
						   asp-route-SortBy="Genre"
						   asp-route-IsDesc="@(Model.SortBy == "Genre" ? !Model.IsDesc : false)"
						   asp-route-Search="@Model.Search"
						   asp-route-Platform="@Model.Platform"
						   asp-route-Genre="@Model.Genre"
						   asp-route-Status="@Model.Status"
						   asp-route-StatusGroup="@Model.StatusGroup"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
							Genre
							@if (Model.SortBy == "Genre")
							{
								<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
							}
						</a>
					</th>
					<th>
						<a asp-action="Index"
						   class="sort-link"
						   title="Sort By Status"
						   asp-route-SortBy="Status"
						   asp-route-IsDesc="@(Model.SortBy == "Status" ? !Model.IsDesc : false)"
						   asp-route-Search="@Model.Search"
						   asp-route-Platform="@Model.Platform"
						   asp-route-Genre="@Model.Genre"
						   asp-route-Status="@Model.Status"
						   asp-route-StatusGroup="@Model.StatusGroup"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
							Status
							@if (Model.SortBy == "Status")
							{
								<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
							}
						</a>
					</th>
					<th>
						<a asp-action="Index"
						   class="sort-link"
						   title="Sort By Rating"
						   asp-route-SortBy="Rating"
						   asp-route-IsDesc="@(Model.SortBy == "Rating" ? !Model.IsDesc : true)"
						   asp-route-Search="@Model.Search"
						   asp-route-Platform="@Model.Platform"
						   asp-route-Genre="@Model.Genre"
						   asp-route-Status="@Model.Status"
						   asp-route-StatusGroup="@Model.StatusGroup"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
							Rating
							@if (Model.SortBy == "Rating")
							{
								<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
							}
						</a>
					</th>
					<th><!--Actions Column--></th>
				</tr>
			</thead>


			<!--Table Body-->
			<tbody>
				@foreach (var game in Model.Games.Items)
				{
					<tr>
						<td>
							<button type="button"
									title="Add Custom Image"
									class="btn p-0 border-0 bg-transparent"
									data-bs-toggle="modal"
									data-bs-target="#imageModal"
									data-id="@game.Id"
									data-page-number="@Model.PageNumber"
									data-image="@game.CustomImageUrl">

								<img src="@(game.CustomImageUrl ?? game.ImageUrl ?? "/images/placeholder.png")"
									 class="img-thumbnail"
									 style="width:120px" />
							</button>
						</td>
						<td>@game.Title</td>
				     	<td class="d-none d-lg-table-cell">@game.Year</td>
				     	<td>
				    		<img src="@Url.Content(game.Platform.GetPlatformIconPath())"
				    			 alt="@game.Platform.GetDisplayName()"
				    			 class="platform-icon @(game.Platform.PlatformIconNeedsInverting() ? "platform-logo-invert" : "")" />
				    	</td>
					    <td class="d-none d-lg-table-cell">@game.Genre.GetDisplayName()</td>
						<td>
							<img src="@Url.Content(game.Status.GetGameStatusIconPath())"
							alt="@game.Status.GetDisplayName()"
							title="@game.Status.GetDisplayName()"
							class="status-icon" />
						</td>
						<td>
							@if (game.Rating.HasValue)
							{
								<partial name="_StarRating"
										 model="new StarRatingViewModel { Rating = game.Rating.Value }" />
							}
						</td>
						<td>
						<div class="d-flex flex-column align-items-center gap-1">
							<a asp-action="Edit"
							   asp-route-id="@game.Id"
							   asp-route-pageNumber="@Model.PageNumber"
							   class="btn btn-sm"
							   title="Edit Game">
								<i class="bi bi-pencil fs-6"></i>
							</a>

							<button type="button"
									title="Delete Game"
									class="btn btn-sm"
									data-bs-toggle="modal"
									data-bs-target="#deleteModal"
									data-id="@game.Id"
									data-pageNumber="@Model.PageNumber"
									data-title="@game.Title">
								<i class="bi bi-trash3 fs-6"></i>
							</button>
						</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
