<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Share Library</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-4">
                    <p class="mb-2">
                        Copy this link to share your library in
                        <strong>Table Format</strong>.
                    </p>

                    <div class="input-group">
                        <input id="shareTableUrlInput"
                               class="form-control"
                               readonly />

                        <button class="btn btn-primary"
                                id="copyTableShareUrlButton"
                                data-bs-dismiss="modal">
                            Copy Link
                        </button>
                    </div>
                </div>


                <div>
                    <p class="mb-2">
                        Copy this link to share your library in
                        <strong>Grid Format</strong>.
                    </p>

                    <div class="input-group">
                        <input id="shareGridUrlInput"
                               class="form-control"
                               readonly />

                        <button class="btn btn-primary"
                                id="copyGridShareUrlButton"
                                data-bs-dismiss="modal">
                            Copy Link
                        </button>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>