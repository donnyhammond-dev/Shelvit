<!--Delete Modal-->

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">

		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">Confirm Delete</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				Are you sure you want to delete <strong id="itemTitle"></strong>?
			</div>

			<div class="modal-footer">

				<form method="post" asp-action="Delete">
					<input type="hidden" name="id" id="deleteId" />
					<input type="hidden" name="pageNumber" id="deletePageNumber" />

					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Cancel Deletion">
						Cancel
					</button>

					<button type="submit" class="btn btn-danger" title="Delete Game">
						Delete
					</button>
				</form>

			</div>

		</div>

	</div>
</div>