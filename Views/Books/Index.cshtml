@using BackLog.ViewModels.BookViewModels
@using BackLog.ViewModels.PartialViewModels
@using BackLog.Enums
@using BackLog.Helpers

@model BookIndexViewModel

<div class="hero-statement">Book Library</div>

<!--Alert Messages-->
@if (TempData["Success"] != null)
{
	<div class="alert alert-success">
		@TempData["Success"]
	</div>
}
@if (TempData["ImageFail"] != null)
{
	<div class="alert alert-success">
		@TempData["ImageFail"]
	</div>
}

<!--Empty State-->
@if (!Model.HasAnyBooks)
{	
	var emptyState = new EmptyStateViewModel
	{
		Title = "Your Book Library is Empty!",
		ButtonText = "Add Your First Book",
		Controller = "Books",
		Action = "Create"
	};
	
	<partial name="_EmptyState" model="emptyState" />
}
else
{
	<!--Toolbar-->
	<div class="mb-3 d-flex flex-column flex-lg-row justify-content-lg-between align-items-stretch align-items-lg-center gap-2">



		<!--Actions-->
		<div class="d-flex gap-2">
			<a asp-controller="Books" asp-action="Create" class="btn btn-primary" title="Add Book">
				<i class="bi bi-plus-lg fs-6"></i>
				<span class="d-none d-lg-inline">Add</span>
			</a>

			<a asp-action="Stats" class="btn btn-primary" title="View Stats">
				<i class="bi bi-bar-chart-fill fs-6"></i>
				<span class="d-none d-lg-inline">Stats</span>
			</a>

			<button type="button"
					class="btn btn-primary"
					title="Share Library"
					data-bs-toggle="modal"
					data-bs-target="#shareModal"
					data-share-table-url="@Url.Action("BooksTable", "SharedLibrary", new { id = Model.ShareToken }, Context.Request.Scheme)"
					data-share-grid-url="@Url.Action("BooksGrid", "SharedLibrary", new { id = Model.ShareToken }, Context.Request.Scheme)">
				<i class="bi bi-box-arrow-up"></i>
				<span class="d-none d-lg-inline">Share</span>
			</button>

			@if (Model.IsGridMode)
			{
				<a asp-action="Index" class="btn" title="Table View"
				   asp-route-IsGridMode="false"
				   asp-route-Search="@Model.Search"
				   asp-route-Format="@Model.Format"
				   asp-route-Genre="@Model.Genre"
				   asp-route-Status="@Model.Status"
				   asp-route-SortBy="@Model.SortBy"
				   asp-route-IsDesc="@Model.IsDesc">
					<i class="bi bi-list-task fs-6"></i>
					<span class="d-none d-lg-inline">Table-View</span>
				</a>
			}
			else
			{
				<a asp-action="Index" class="btn" title="Grid View"
				   asp-route-IsGridMode="true"
				   asp-route-Search="@Model.Search"
				   asp-route-Format="@Model.Format"
				   asp-route-Genre="@Model.Genre"
				   asp-route-Status="@Model.Status"
				   asp-route-SortBy="@Model.SortBy"
				   asp-route-IsDesc="@Model.IsDesc">
					<i class="bi bi-grid-3x3-gap fs-6"></i>
					<span class="d-none d-lg-inline">Grid-View</span>
				</a>
			}

		</div>

		<!--Filters-->
		<form method="get" class="d-flex gap-2">

			<input type="hidden" asp-for="IsGridMode" />
			<input type="hidden" asp-for="IsViewAllMode" />

			<input asp-for="Search" class="form-control search-submit" placeholder="Search" />
			<select asp-for="Format" asp-items="Model.FormatList" class="form-select auto-submit"></select>
			<select asp-for="Genre" asp-items="Model.GenreList" class="form-select auto-submit"></select>
			<select asp-for="Status" asp-items="Model.StatusList" class="form-select auto-submit"></select>

			<a asp-action="Index" class="btn btn-primary" title="Reset Search Filters"
			   asp-route-IsGridMode="@Model.IsGridMode">
				<i class="bi bi-arrow-counterclockwise fs-6"></i>
			</a>

		</form>

	</div>



	<!--Card-->
	<div class="card">

		<!--Library Display-->
		@if (Model.IsGridMode) 
		{
			<partial name="_BookGrid" model="Model" />
		}
		else
		{
			<partial name="_BookTable" model="Model" />
		}

		<!--Pagination/Empty Search State-->
		@if (!Model.Books.Items.Any())
		{
			<div class="text-center text-muted py-4">
				<h4>No results found</h4>
				<p>Try different filter options</p>
			</div>
		}
		else
		{
			<nav>
				<ul class="pagination justify-content-center mt-4">

					@if (Model.Books.HasPreviousPage)
					{
						<li class="page-item">
							<a class="page-link"
							   asp-action="Index"
							   asp-route-IsGridMode="@Model.IsGridMode"
							   asp-route-pageNumber="@(Model.Books.PageIndex - 1)"
							   asp-route-Search="@Model.Search"
							   asp-route-format="@Model.Format"
							   asp-route-genre="@Model.Genre"
							   asp-route-status="@Model.Status"
							   asp-route-sortBy="@Model.SortBy"
							   asp-route-isDesc="@Model.IsDesc">
								Previous
							</a>
						</li>
					}

					<li class="page-item disabled">
						<span class="page-link">
							Page @Model.Books.PageIndex of @Model.Books.TotalPages
						</span>
					</li>

					@if (Model.Books.HasNextPage)
					{
						<li class="page-item">
							<a class="page-link"
							   asp-action="Index"
							   asp-route-IsGridMode="@Model.IsGridMode"
							   asp-route-pageNumber="@(Model.Books.PageIndex + 1)"
							   asp-route-Search="@Model.Search"
							   asp-route-format="@Model.Format"
							   asp-route-genre="@Model.Genre"
							   asp-route-status="@Model.Status"
							   asp-route-sortBy="@Model.SortBy"
							   asp-route-isDesc="@Model.IsDesc">
								Next
							</a>
						</li>
					}
				</ul>
			</nav>

			<!--View All Toggle-->
			<form method="get" class="text-center mb-2">

				<!-- Preserve Filters -->
				<input type="hidden" asp-for="Search" />
				<input type="hidden" asp-for="Format" />
				<input type="hidden" asp-for="Genre" />
				<input type="hidden" asp-for="Status" />
				<input type="hidden" asp-for="SortBy" />
				<input type="hidden" asp-for="IsDesc" />
				<input type="hidden" asp-for="IsGridMode" />
				<input type="hidden" asp-for="PageNumber" />

				<div class="form-check d-inline-block">
					<input asp-for="IsViewAllMode"
						   class="form-check-input"
						   onchange="this.form.submit()" />

					<label asp-for="IsViewAllMode" class="form-check-label">
						View All
					</label>
				</div>

			</form>
		}



	</div>
}

<!--Delete Modal-->
<partial name="_DeleteModal" />

<!--Edit Image Modal-->
<partial name="_UpdateImageModal" />

<!--ShareUrl Modal-->
<partial name="_ShareUrlModal" />





