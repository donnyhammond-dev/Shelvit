@using BackLog.ViewModels.BookViewModels
@using BackLog.Helpers

@model BookIndexViewModel

<div class="container-fluid py-3">
	<div class="row g-3">

		@foreach (var book in Model.Books.Items)
		{
			<div class="col-4 col-sm-3 col-md-2">
				<div class="portrait-grid-image"
					 title="@book.Title&#10;@book.Author&#10;@book.Year&#10;@book.Format&#10;@book.Status.GetDisplayName()&#10;@(book.Rating.HasValue ? $"{book.Rating}/5" : "")">

					<img src="@(book.CustomImageUrl ?? book.ImageUrl ?? "/images/placeholder.png")"
						 alt="@book.Title" />

				</div>
			</div>
		}

	</div>
</div>