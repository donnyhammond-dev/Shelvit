@using BackLog.ViewModels.BookViewModels
@using BackLog.ViewModels.PartialViewModels
@using BackLog.Enums
@using BackLog.Helpers

@model BookIndexViewModel

<div class="table-header">
	<table class="table table-striped table-hover">

		<!--Table Header-->
		<thead class="table-primary">
			<tr>
				<th style="width:12%"> <!--Book Image--> </th>

				<th style="width:16%">
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Title"
					   asp-route-SortBy="Title"
					   asp-route-IsDesc="@(Model.SortBy == "Title" || Model.SortBy == null ? !Model.IsDesc : false)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Title
						@if (Model.SortBy == "Title" || Model.SortBy == null)
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>

				<th style="width:14%">
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Author"
					   asp-route-SortBy="Author"
					   asp-route-IsDesc="@(Model.SortBy == "Author" ? !Model.IsDesc : false)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Author
						@if (Model.SortBy == "Author")
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>

				<th style="width:7%" class="d-none d-lg-table-cell">
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Year"
					   asp-route-SortBy="Year"
					   asp-route-IsDesc="@(Model.SortBy == "Year" ? !Model.IsDesc : false)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Year
						@if (Model.SortBy == "Year")
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>

				<th>
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Format"
					   asp-route-SortBy="Format"
					   asp-route-IsDesc="@(Model.SortBy == "Format" ? !Model.IsDesc : false)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Format
						@if (Model.SortBy == "Format")
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>

				<th class="d-none d-lg-table-cell">
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Genre"
					   asp-route-SortBy="Genre"
					   asp-route-IsDesc="@(Model.SortBy == "Genre" ? !Model.IsDesc : false)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Genre
						@if (Model.SortBy == "Genre")
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>

				<th>
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Status"
					   asp-route-SortBy="Status"
					   asp-route-IsDesc="@(Model.SortBy == "Status" ? !Model.IsDesc : false)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Status
						@if (Model.SortBy == "Status")
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>

				<th>
					<a asp-action="Index"
					   class="sort-link"
					   title="Sort By Rating"
					   asp-route-SortBy="Rating"
					   asp-route-IsDesc="@(Model.SortBy == "Rating" ? !Model.IsDesc : true)"
					   asp-route-Search="@Model.Search"
					   asp-route-Format="@Model.Format"
					   asp-route-Genre="@Model.Genre"
					   asp-route-Status="@Model.Status"
					   asp-route-isViewAllMode="@Model.IsViewAllMode">
						Rating
						@if (Model.SortBy == "Rating")
						{
							<i class="bi @(Model.IsDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
						}
					</a>
				</th>
				<th class="text-primary"><!--Actions Column--></th>
			</tr>
		</thead>

		<!--Table Body-->
		<tbody>
			@foreach (var book in Model.Books.Items)
			{
				<tr>
					<td>
						<button type="button"
								class="btn p-0 border-0 bg-transparent"
								data-bs-toggle="modal"
								data-bs-target="#imageModal"
								data-id="@book.Id"
								data-page-number="@Model.PageNumber"
								data-image="@book.CustomImageUrl">

							<img src="@(book.CustomImageUrl ?? book.ImageUrl ?? "/images/placeholder.png")"
								 class="img-thumbnail"
								 style="width:180px;" />
						</button>
					</td>

					<td><strong>@book.Title</strong></td>
					<td><strong>@book.Author</strong></td>
					<td class="d-none d-lg-table-cell">@(book.Year?.ToString() ?? "")</td>
					<td>
						<img src="@Url.Content(book.Format.GetBookFormatIconPath())"
							 alt="@book.Format.GetDisplayName()"
							 title="@book.Format.GetDisplayName()"
							 class="book-format-icon" />
					</td>
					<td class="d-none d-lg-table-cell">@book.Genre</td>

					<td>
						<img src="@Url.Content(book.Status.GetStatusIconPath())"
							 alt="@book.Status.GetDisplayName()"
							 title="@book.Status.GetDisplayName()"
							 class="status-icon" />
					</td>

					<td>
						@if (book.Rating.HasValue)
						{
							<partial name="_StarRating"
									 model="new StarRatingViewModel { Rating = book.Rating.Value }" />
						}
					</td>

					<td>
						<div class="d-flex flex-column align-items-center gap-1">
							<a asp-action="Edit"
							   asp-route-id="@book.Id"
							   asp-route-pageNumber="@Model.PageNumber"
							   class="btn btn-sm btn-primary"
							   title="Edit Book">
								<i class="bi bi-pencil fs-6"></i>
							</a>

							<button type="button"
									class="btn btn-sm btn-outline-primary"
									title="Delete Book"
									data-bs-toggle="modal"
									data-bs-target="#deleteModal"
									data-id="@book.Id"
									data-pageNumber="@Model.PageNumber"
									data-title="@book.Title">
								<i class="bi bi-trash3 fs-6"></i>
							</button>
						</div>
					</td>
				</tr>
			}
		</tbody>

	</table>
</div>